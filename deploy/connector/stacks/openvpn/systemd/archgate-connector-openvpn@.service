[Unit]
Description=ArchGate OpenVPN connector for site %i
After=network-online.target
Wants=network-online.target
# Do not start Warpgate dependency here — Swarm owns gateways

[Service]
Type=notify
# OpenVPN may not support Type=notify on all builds; fallback:
# Type=simple
WorkingDirectory=/var/lib/archgate/connector/%i/openvpn
ExecStart=/usr/sbin/openvpn --config /var/lib/archgate/connector/%i/openvpn/client.ovpn --writepid /run/archgate-ovpn-%i.pid
ExecStartPost=/bin/sleep 2
Restart=on-failure
RestartSec=5
# Capability for tun
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
