[Unit]
Description=ArchGate openfortivpn connector for site %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/openfortivpn -c /var/lib/archgate/connector/%i/forti/openfortivpn.conf
Restart=on-failure
RestartSec=10
# Needs tun
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
