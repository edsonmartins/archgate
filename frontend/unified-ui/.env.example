# UnifiedUI — public client only (no secrets)

# Catalog / auth BFF (proxied by Vite in dev)
# VITE_API_BASE=/api

# OIDC Kanidm (Code+PKCE). Off by default → mock lab login.
# VITE_OIDC_ENABLED=1
# VITE_OIDC_ISSUER=https://id.archgate.com.br/oauth2/openid/archgate-unified-ui
# VITE_OIDC_CLIENT_ID=archgate-unified-ui
# VITE_OIDC_REDIRECT_URI=http://localhost:5174/auth/callback
# VITE_OIDC_SCOPES=openid profile email

# Warpgate bastion endpoints for launch snippets (W4-UI07)
# VITE_WG_SSH_HOST=wg.archgate.com.br
# VITE_WG_SSH_PORT=2222
# VITE_WG_PG_HOST=wg.archgate.com.br
# VITE_WG_PG_PORT=55432
# VITE_WG_PG_DB=archgate_lab

# Guacamole embed (W4-UI11) — token always from BFF in prod
# VITE_GUAC_DEMO=1
# VITE_GUAC_TUNNEL_WS=ws://127.0.0.1:4822/
