{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default capabilities for ArchGate Connect",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:tray:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-close",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/archgate",
          "sidecar": true,
          "args": true
        },
        {
          "name": "archgate",
          "cmd": "archgate",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/archgate",
          "sidecar": true,
          "args": true
        },
        {
          "name": "archgate",
          "cmd": "archgate",
          "args": true
        }
      ]
    }
  ]
}
