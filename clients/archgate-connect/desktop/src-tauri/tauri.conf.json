{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArchGate Connect",
  "version": "0.2.0",
  "identifier": "br.com.archgate.connect",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ArchGate Connect",
        "width": 500,
        "height": 780,
        "minWidth": 420,
        "minHeight": 620,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "externalBin": [
      "binaries/archgate"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
